# Stripe — copy to .env (never commit real keys)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Flutterwave dashboard label mapping:
#   Client Secret -> FLUTTERWAVE_SECRET_KEY
#   Public Key -> FLUTTERWAVE_PUBLIC_KEY
#   Test webhooks hash -> FLUTTERWAVE_WEBHOOK_SECRET (optional)
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
APP_URL=http://127.0.0.1:8000
DATABASE_URL=postgresql://user:pass@localhost:5432/yourdb
